# FLEX-OP backend — copiar a .env y ajustar valores

# Desarrollo
DEBUG=True
SECRET_KEY=django-insecure-dev-key-change-in-production-12345
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (opcional en local — sin esto usa SQLite)
# DATABASE_URL=postgres://flexop:flexop_dev@localhost:5432/flexop

# Producción (obligatorio)
# DEBUG=False
# SECRET_KEY=generar-clave-segura-unica
# ALLOWED_HOSTS=tu-dominio.com,api.tu-dominio.com
# CORS_ALLOWED_ORIGINS=https://tu-dominio.com

# JWT (opcional)
# JWT_ACCESS_TOKEN_LIFETIME=60
# JWT_REFRESH_TOKEN_LIFETIME=1440
