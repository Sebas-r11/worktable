# Variables para Render (backend Django + SQLite)
# Copiar cada clave en: Render → tu servicio → Environment

DEBUG=False
SECRET_KEY=genera-una-clave-larga-aleatoria-aqui
ALLOWED_HOSTS=flexop-api.onrender.com
CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app

# No definir DATABASE_URL → usa SQLite (db.sqlite3)

POPULATE_SCALE=demo
SERVE_MEDIA=1

# Solo si quieres forzar recarga de datos demo:
# POPULATE_RESET=1
