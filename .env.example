# FLEX-OP — producción (copiar a .env en la raíz del proyecto)
# docker compose -f docker-compose.prod.yml up --build -d

DEBUG=False
SECRET_KEY=cambiar-por-clave-segura-unica
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=flexop
POSTGRES_USER=flexop
POSTGRES_PASSWORD=cambiar-password-seguro
DATABASE_URL=postgres://flexop:cambiar-password-seguro@db:5432/flexop

# Solo en el primer despliegue o entornos demo
RUN_POPULATE=0

NEXT_PUBLIC_API_URL=/api
BACKEND_INTERNAL_URL=http://backend:8000
